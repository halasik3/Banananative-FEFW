@@ -61,6 +61,18 @@ add_library(vpx STATIC ${VPX_C})
 target_include_directories(vpx PRIVATE ${TP}/libvpx ${TP}/libvpx/config)
 target_compile_options(vpx PRIVATE -O2 -w)
 
+# dav1d (AV1 movies: Fortune's Weave's, in hle_nx2_movie.c), with its arm64 NEON assembly. As dm/host/Makefile builds it for the Mac: the *_tmpl.c files go through the per-bit-depth wrappers in
+# config/tmpl, and the assembly other assembly files include (*_tmpl.S, util.S) is not built on its own. config/android/config.h comes before config/config.h: ELF symbols have no underscore prefix
+# (PREFIX 0) and Bionic has getauxval, which dav1d's arm CPU detection reads
+file(GLOB DAV1D_SRC CONFIGURE_DEPENDS ${TP}/dav1d/src/*.c)
+list(FILTER DAV1D_SRC EXCLUDE REGEX "_tmpl\\.c$")
+file(GLOB DAV1D_TMPL CONFIGURE_DEPENDS ${TP}/dav1d/config/tmpl/*.c)
+file(GLOB DAV1D_ASM CONFIGURE_DEPENDS ${TP}/dav1d/src/arm/64/*.S)
+list(FILTER DAV1D_ASM EXCLUDE REGEX "(_tmpl\\.S|/util\\.S)$")
+add_library(dav1d STATIC ${DAV1D_SRC} ${DAV1D_TMPL} ${TP}/dav1d/src/arm/cpu.c ${DAV1D_ASM})
+target_include_directories(dav1d PRIVATE ${TP}/dav1d ${TP}/dav1d/include ${TP}/dav1d/config/android ${TP}/dav1d/config)
+target_compile_options(dav1d PRIVATE -O2 -w -fvisibility=hidden -fomit-frame-pointer)
+
 # zstd's decompressor (one file, dm/third_party/zstd): the Vulkan replay's shader library stores its SPIR-V modules as zstd frames (vka_shlib.c)
 add_library(zstddec STATIC ${TP}/zstd/zstddeclib.c)
 target_compile_options(zstddec PRIVATE -O2 -w -fvisibility=hidden)
@@ -73,7 +85,7 @@ function(nxhost_add tgt game)
     DEPENDS ${ROOT}/dm/games/${game}/game.tsv ${ROOT}/dm/games/game.py
     COMMENT "game profile ${game}")
   add_library(${tgt} SHARED ${HOST_C} ${GFX_C} ${ASM_OUT} ${GAME_H})
