+    mc_dsp_init_arm(c);
+#elif ARCH_LOONGARCH64
+    mc_dsp_init_loongarch(c);
+#elif ARCH_PPC64LE
+    mc_dsp_init_ppc(c);
+#elif ARCH_RISCV
+    mc_dsp_init_riscv(c);
+#elif ARCH_X86
+    mc_dsp_init_x86(c);
+#endif
+#endif
+}
