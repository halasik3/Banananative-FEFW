diff --git a/dm/third_party/dav1d/src/pal.c b/dm/third_party/dav1d/src/pal.c
new file mode 100644
index 0000000..8e2cdec
--- /dev/null
+++ b/dm/third_party/dav1d/src/pal.c
@@ -0,0 +1,81 @@
+/*
