+                           w, params->sgr.s1, BITDEPTH_MAX);
+        rotate_neon(A3_ptrs, B3_ptrs, 4);
+
+        if (--h <= 0)
+            goto vert_1;
+
+        BF(dav1d_sgr_box35_row_h, neon)(sumsq3_ptrs[2], sum3_ptrs[2],
+                                        sumsq5_rows[3], sum5_rows[3],
